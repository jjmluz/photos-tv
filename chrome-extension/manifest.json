{
  "manifest_version": 3,
  "name": "Fotos TV",
  "version": "1.0",
  "description": "Mantém a sessão do Google Fotos da app Fotos TV sincronizada com este navegador.",
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": ["https://*.google.com/*"],
  "optional_host_permissions": ["http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Fotos TV", "default_popup": "popup.html" }
}
